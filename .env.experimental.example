# Rasaoi Outcome Engine — EXPERIMENTAL / STAGING credentials
# Copy to .env.experimental and fill locally. NEVER commit real values.
# Production .env / Vercel Production env must remain untouched.
#
# Preferred path (no Docker): dedicated Supabase staging + Vercel Preview
#   See docs/experimental/STAGING_PREVIEW_SETUP.md
#
# Usage:
#   cp .env.experimental.example .env.experimental

EXPERIMENTAL_MODE=true

# --- Staging Supabase (PRIMARY — replaces Docker for preview path) ---
EXPERIMENTAL_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
EXPERIMENTAL_SUPABASE_ANON_KEY=
EXPERIMENTAL_SUPABASE_SERVICE_ROLE_KEY=
EXPERIMENTAL_SUPABASE_PROJECT_ID=YOUR_STAGING_REF
# Optional DB URL from Dashboard → Database → Connection string (URI)
# EXPERIMENTAL_DATABASE_URL=

# NEVER point these at prod kiugplotjcnmpwjlxajc for experimental writes.

# --- Model-agnostic router (optional; staging usually uses Gemini via edge secrets) ---
# EXPERIMENTAL_LLM_BASE_URL=
# EXPERIMENTAL_LLM_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

EXPERIMENTAL_MODEL_PARSE_INTENT=gemini/gemini-flash-latest
EXPERIMENTAL_MODEL_RECIPE_INVERT=openai/gpt-4o-mini
EXPERIMENTAL_MODEL_ADVERSARIAL_USER=anthropic/claude-3-5-sonnet-latest
EXPERIMENTAL_MODEL_EVALUATE=openai/gpt-4o

# --- External enrichment (sandbox only) ---
# APIFY_TOKEN=
# APIFY_WEBHOOK_SECRET=
# USDA_FDC_API_KEY=

# --- Vector backend ---
VECTOR_BACKEND=pgvector

# --- Frontend experimental flags (default OFF) ---
VITE_EXPERIMENTAL_DYNAMIC_CULINARY=false
VITE_EXPERIMENTAL_MODEL_ROUTER=false

# --- Docker (OPTIONAL / ignored for staging-preview path) ---
# EXPERIMENTAL_DATABASE_URL=postgres://rasaoi:rasaoi@localhost:54329/rasaoi_exp
